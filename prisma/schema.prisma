// Prisma Schema for KIST Poly Clinic
// Migrated from Django models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  patient
  admin
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
}

enum LaboratoryTestStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PharmacyOrderStatus {
  pending
  processing
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  completed
  failed
}

enum PrescriptionStatus {
  pending
  verified
  rejected
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
}

/// How a patient books a given doctor.
///
/// `scheduled` doctors have real weekly hours and the patient picks an exact
/// time. `on_call` doctors have no fixed clinic hours, so the patient submits a
/// preferred date and the clinic confirms an actual time — offering them a
/// timetable would be inventing one.
enum DoctorBookingMode {
  scheduled
  on_call
}

// Models
model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  email     String   @unique
  name      String
  address   String?
  password  String
  role      UserRole @default(patient)
  isActive  Boolean  @default(true) @map("is_active")
  isStaff   Boolean  @default(false) @map("is_staff")
  /// Stamped whenever the password changes. Sessions issued before this moment
  /// are rejected, so a reset actually evicts a stolen session instead of
  /// leaving it valid for the rest of the JWT's 24-hour life.
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  appointments        Appointment[]
  laboratoryTests     LaboratoryTest[]
  pharmacyOrders      PharmacyOrder[]
  medicalRecords      MedicalRecord[]
  prescriptions       Prescription[]
  passwordResetTokens PasswordResetToken[]

  @@index([phone, isActive])
  @@index([createdAt])
  @@map("users")
}

model Medicine {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Decimal     @db.Decimal(10, 2)
  image       String?
  category    String
  stock       StockStatus @default(IN_STOCK)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  orders PharmacyOrder[]

  @@index([category])
  @@index([stock])
  @@map("medicines")
}

/// A doctor who can be booked.
///
/// Doctors previously existed only in `src/data/doctors.ts`, and Appointment
/// stored `doctorName` as free text — so renaming a doctor silently detached
/// every historical appointment, and nothing could enforce availability.
///
/// That file is still the content source for the marketing pages (it drives
/// static generation); `prisma/seed.ts` mirrors it into this table, which is
/// the authority for booking. `legacyId` keeps the existing /doctors/[id] URLs
/// working.
model Doctor {
  id                  String            @id @default(cuid())
  slug                String            @unique
  legacyId            Int?              @unique @map("legacy_id")
  name                String
  specialty           String
  education           String
  experience          String
  image               String?
  /// The human sentence shown on the doctor card ("Sun-Wed: 10AM - 5PM").
  scheduleNote        String            @map("schedule_note")
  opdCharge           Decimal           @map("opd_charge") @db.Decimal(10, 2)
  nmcNumber           String            @map("nmc_number")
  bookingMode         DoctorBookingMode @default(on_call) @map("booking_mode")
  slotDurationMinutes Int               @default(30) @map("slot_duration_minutes")
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  // Relations
  schedules    DoctorSchedule[]
  appointments Appointment[]

  @@index([isActive])
  @@map("doctors")
}

/// One recurring weekly working window for a doctor.
///
/// Times are stored as minutes from midnight rather than strings so that
/// ordering and overlap checks are plain integer comparisons.
model DoctorSchedule {
  id          String @id @default(cuid())
  doctorId    String @map("doctor_id")
  /// 0 = Sunday ... 6 = Saturday, matching JavaScript's `Date.getDay()`.
  dayOfWeek   Int    @map("day_of_week")
  startMinute Int    @map("start_minute")
  /// Exclusive: a 10:00-17:00 window with 30-minute slots ends at 16:30.
  endMinute   Int    @map("end_minute")

  // Relations
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startMinute])
  @@index([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model Appointment {
  id        String @id @default(cuid())
  patientId String @map("patient_id")

  /// Nullable so appointments booked before the Doctor table existed survive
  /// the migration. New bookings always set it.
  doctorId String? @map("doctor_id")

  /// Snapshots, deliberately kept alongside `doctorId`. An appointment is a
  /// historical record: it should still read correctly if the doctor is later
  /// renamed, changes specialty, or leaves the clinic.
  doctorName           String   @map("doctor_name")
  doctorSpecialization String   @map("doctor_specialization")
  /// The consultation fee agreed at booking time. Previously shown at
  /// confirmation and then thrown away, so appointments carried no price.
  opdCharge            Decimal? @map("opd_charge") @db.Decimal(10, 2)

  appointmentDate DateTime          @map("appointment_date") @db.Date
  /// 24-hour "HH:MM". Empty for on-call requests, where the clinic sets the
  /// time when it confirms.
  appointmentTime String            @map("appointment_time")
  status          AppointmentStatus @default(pending)
  reason          String?
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  patient User    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor? @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  // NOTE: uniqueness on (doctorId, appointmentDate, appointmentTime) is enforced
  // by a PARTIAL unique index that only covers live appointments, so a
  // cancelled 10:00 slot can be rebooked. Prisma cannot express a partial index,
  // so it is created as raw SQL in the migration and is invisible here. See
  // prisma/migrations/20260810130000_doctors_and_slots/migration.sql.
  @@index([patientId, appointmentDate])
  @@index([status])
  @@index([doctorId, appointmentDate])
  @@map("appointments")
}

model LaboratoryTest {
  id              String               @id @default(cuid())
  patientId       String               @map("patient_id")
  testName        String               @map("test_name")
  testDescription String               @map("test_description")
  testDate        DateTime             @map("test_date") @db.Date
  testTime        String               @map("test_time")
  status          LaboratoryTestStatus @default(pending)
  notes           String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  // Relations
  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, testDate])
  @@index([status])
  @@map("laboratory_tests")
}

model PharmacyOrder {
  id              String              @id @default(cuid())
  patientId       String              @map("patient_id")
  medicineId      String              @map("medicine_id")
  quantity        Int                 @default(1)
  pricePerUnit    Decimal             @map("price_per_unit") @db.Decimal(10, 2)
  totalAmount     Decimal             @map("total_amount") @db.Decimal(10, 2)
  deliveryAddress String?             @map("delivery_address")
  paymentMethod   String?             @map("payment_method")
  status          PharmacyOrderStatus @default(pending)
  paymentStatus   PaymentStatus       @default(pending) @map("payment_status")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Relations
  patient  User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@index([medicineId])
  @@index([paymentStatus])
  @@map("pharmacy_orders")
}

model MedicalRecord {
  id          String   @id @default(cuid())
  patientId   String   @map("patient_id")
  title       String
  description String?
  fileUrl     String   @map("file_url")
  fileType    String   @map("file_type")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([createdAt])
  @@map("medical_records")
}

/// Single-use, short-lived password reset tokens.
///
/// Only the SHA-256 hash of the token is stored: a leaked database dump must
/// not hand the attacker a working reset link for every pending request. The
/// raw token exists only in the emailed URL.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// Set the moment the token is redeemed, making replay impossible.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Prescription {
  id                   String             @id @default(cuid())
  patientId            String             @map("patient_id")
  prescriptionImageUrl String             @map("prescription_image_url")
  status               PrescriptionStatus @default(pending)
  notes                String?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  // Relations
  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@map("prescriptions")
}
